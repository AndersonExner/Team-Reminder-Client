<UserControl x:Class="TeamReminder.Windows.AccountControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Account_Loaded">
    <StackPanel Spacing="4">
        <!-- Signed out: a compact sign-in form. -->
        <Border x:Name="SignedOutPanel" Style="{StaticResource CardStyle}" Padding="20">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE77B;" FontSize="32" VerticalAlignment="Top" Margin="4,4,0,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Entre na sua conta" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Sincronize seus alarmes entre computadores e participe de grupos. Os alarmes continuam funcionando neste computador mesmo sem conta."
                            Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RegisterToggle" Header="Criar uma nova conta" OnContent="Cadastro" OffContent="Entrar" Toggled="Register_Toggled" />
                    <TextBox x:Name="NameInput" Header="Nome" MaxLength="100" Visibility="Collapsed" />
                    <TextBox x:Name="EmailInput" Header="E-mail" MaxLength="254" InputScope="EmailSmtpAddress" />
                    <PasswordBox x:Name="PasswordInput" Header="Senha" MaxLength="128" />
                    <TextBlock x:Name="PasswordHint" Text="Use uma senha de 10 a 128 caracteres." Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <PasswordBox x:Name="ConfirmInput" Header="Confirmar senha" MaxLength="128" Visibility="Collapsed" />
                    <Button x:Name="SubmitButton" Content="Entrar" Click="Submit_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Signed in: who is connected and how synchronization is going. -->
        <StackPanel x:Name="SignedInPanel" Visibility="Collapsed" Spacing="4">
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <PersonPicture Width="44" Height="44" DisplayName="{Binding Text, ElementName=UserName}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UserName" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="UserEmail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="LogoutButton" Grid.Column="2" Content="Sair da conta" Click="Logout_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="0" RowSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Sincronização" />
                        <TextBlock x:Name="SyncStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SyncButton" Content="Sincronizar agora" Click="Sync_Click" />
                        <Button x:Name="ImportButton" Content="Adicionar alarmes locais à conta" Click="Import_Click" />
                        <Button x:Name="ConflictsButton" Content="Revisar alterações simultâneas" Visibility="Collapsed" Click="Conflicts_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <ProgressBar x:Name="AccountProgress" IsIndeterminate="True" Visibility="Collapsed" />
        <TextBlock x:Name="AccountStatus" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" Margin="2,4,0,0" />
        <Button x:Name="RetryButton" Content="Tentar reconectar" Visibility="Collapsed" Click="Retry_Click" />
    </StackPanel>
</UserControl>
