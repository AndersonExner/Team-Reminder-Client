<Window x:Class="TeamReminder.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeamReminder.Windows"
    Title="Team Reminder">
    <Grid x:Name="Root" Padding="24" RowSpacing="12" Loaded="Root_Loaded"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Team Reminder" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Seus compromissos, no momento certo." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,6" CornerRadius="16"
                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <TextBlock x:Name="AccountBadge" Text="Local" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="6">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy}" />
            <InfoBar Title="Alarmes recebidos" Message="{Binding AlertText}" IsOpen="{Binding HasAlerts}" IsClosable="False" Severity="Informational">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ReceivedAlarms}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Spacing="4" Margin="0,8,0,0" Visibility="{Binding HasLink}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="OpenLink_Click"
                                Visibility="{Binding HasLink}" ToolTipService.ToolTip="{Binding ActionUrl}" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <InfoBar.ActionButton><Button Content="Dispensar" Command="{Binding DismissAlertsCommand}" /></InfoBar.ActionButton>
            </InfoBar>
            <TextBlock Text="{Binding NotificationStatus}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="TrayStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <TabView x:Name="MainTabs" Grid.Row="2" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" SelectionChanged="MainTabs_SelectionChanged">
            <TabViewItem Header="Alarmes" IsClosable="False">
                <TabViewItem.IconSource><SymbolIconSource Symbol="Clock" /></TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,16,0,0" ColumnSpacing="20" RowSpacing="20">
                        <Border x:Name="ListPanel" Padding="20" CornerRadius="12" VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Meus alarmes" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Selecione um alarme para editar ou excluir." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Novo alarme" Click="NewAlarm_Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Editar" Click="EditAlarm_Click" IsEnabled="{Binding CanEditSelected}" />
                                    <Button Content="Excluir" Click="DeleteAlarm_Click" IsEnabled="{Binding CanEditSelected}" />
                                    <Button Command="{Binding ReloadCommand}" ToolTipService.ToolTip="Atualizar / tentar novamente" AutomationProperties.Name="Atualizar alarmes"><SymbolIcon Symbol="Refresh" /></Button>
                                </StackPanel>
                                <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" />
                                <ListView ItemsSource="{Binding Alarms}" SelectionMode="Single" MaxHeight="600"
                                    SelectedItem="{Binding SelectedAlarm, Mode=TwoWay}" IsEnabled="{Binding CanEdit}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4,12" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <SymbolIcon Symbol="Clock" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Schedule}" />
                                                    <TextBlock Text="{Binding RecurrenceText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding SoundText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="OpenLink_Click"
                                                        Visibility="{Binding HasLink}" ToolTipService.ToolTip="{Binding ActionUrl}" />
                                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Configurações" IsClosable="False">
                <TabViewItem.IconSource><SymbolIconSource Symbol="Setting" /></TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0" Spacing="20" MaxWidth="680" HorizontalAlignment="Left">
                        <local:AccountControl x:Name="AccountPanel" />
                        <Border Padding="24" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Aparência" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Escolha como o Team Reminder aparece neste computador." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="ThemePicker" Header="Tema" MinWidth="240" SelectionChanged="ThemePicker_SelectionChanged">
                                    <ComboBoxItem Content="Padrão do Windows" /><ComboBoxItem Content="Claro" /><ComboBoxItem Content="Escuro" />
                                </ComboBox>
                                <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border Padding="24" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Som padrão dos alarmes" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Usado pelos alarmes que seguem o padrão do aplicativo." TextWrapping="Wrap" />
                                <local:SoundPickerControl x:Name="DefaultSoundEditor" />
                                <TextBlock x:Name="DefaultSoundStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border Padding="24" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Lembrete antecipado" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Receba um aviso na bandeja antes do horário de cada alarme." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="AdvancePicker" Header="Notificar antes" MinWidth="240" SelectionChanged="AdvancePicker_SelectionChanged">
                                    <ComboBoxItem Content="Desativado" /><ComboBoxItem Content="5 minutos antes" />
                                    <ComboBoxItem Content="10 minutos antes" /><ComboBoxItem Content="15 minutos antes" />
                                    <ComboBoxItem Content="30 minutos antes" /><ComboBoxItem Content="1 hora antes" />
                                </ComboBox>
                                <TextBlock x:Name="AdvanceStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border Padding="24" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Inicialização" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ToggleSwitch x:Name="StartupToggle" Header="Iniciar com o Windows" OnContent="Ativado" OffContent="Desativado" Toggled="StartupToggle_Toggled" />
                                <TextBlock Text="Ao entrar no Windows, o aplicativo fica na bandeja sem abrir a janela." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="StartupStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="Sobre os alarmes" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Os alarmes ficam neste computador. Fechar a janela mantém o app na bandeja; Sair encerra os alarmes." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Grupos" IsClosable="False">
                <TabViewItem.IconSource><SymbolIconSource Symbol="People" /></TabViewItem.IconSource>
                <local:GroupsControl x:Name="GroupsPanel" />
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
