<ContentDialog x:Class="TeamReminder.Windows.AlarmEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TeamReminder.Windows"
    Title="{Binding FormTitle}" PrimaryButtonText="{Binding SaveLabel}" SecondaryButtonText="Cancelar"
    DefaultButton="Primary" IsPrimaryButtonEnabled="{Binding CanEdit}" IsSecondaryButtonEnabled="{Binding CanEdit}"
    PrimaryButtonClick="Save_Click" Closing="Dialog_Closing" Opened="Dialog_Opened">
    <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">640</x:Double></ContentDialog.Resources>
    <ScrollViewer Background="{ThemeResource ContentDialogBackground}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="580" IsEnabled="{Binding CanEdit}">
        <StackPanel Spacing="16" MinWidth="360" MaxWidth="560">
            <TextBlock Text="Defina quem recebe e quando lembrar. O aviso sempre toca no computador de cada participante."
                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border Padding="16" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Quem recebe" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination, Mode=TwoWay}"
                        IsEnabled="{Binding CanChooseDestination}" HorizontalAlignment="Stretch" AutomationProperties.Name="Destinatário do alarme">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding DestinationHint}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding GroupSelectionMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="8">
                <TextBlock Text="O que lembrar" FontWeight="SemiBold" />
                <TextBox x:Name="AlarmTitle" PlaceholderText="Ex.: reunião da equipe ou registrar o ponto" MaxLength="120"
                    AutomationProperties.Name="Título do alarme" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding TitleError}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Padding="16" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Quando lembrar" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <CalendarDatePicker Header="Data inicial" MinWidth="0" HorizontalAlignment="Stretch" Date="{Binding SelectedDate, Mode=TwoWay}" PlaceholderText="Selecione a data" />
                        <TimePicker Grid.Column="1" Header="Horário" MinWidth="0" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock" SelectedTime="{Binding SelectedTime, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="{Binding ScheduleError}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    <ComboBox Header="Repetição" SelectedIndex="{Binding RecurrenceIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Uma vez" /><ComboBoxItem Content="Todos os dias" /><ComboBoxItem Content="Dias da semana" />
                    </ComboBox>
                    <ItemsControl ItemsSource="{Binding DayOptions}" Visibility="{Binding ShowWeekDays}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" MinWidth="110" IsChecked="{Binding IsSelected, Mode=TwoWay}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding RecurrenceError}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Expander Header="Link de ação (opcional)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBox Header="Endereço" PlaceholderText="https://..." MaxLength="2048" Text="{Binding ActionUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Texto do botão" PlaceholderText="Abrir link" MaxLength="40" Text="{Binding ActionLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="O link abre somente quando você clicar na notificação." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ActionError}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
            <Expander Header="Som do alarme" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <local:SoundPickerControl x:Name="SoundEditor" />
            </Expander>
            <TextBlock Text="{Binding Sound.Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SoundError}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ActionError}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            <TextBlock Text="Para um aviso único, escolha uma data e horário futuros. Alarmes de grupo seguem o mesmo instante em todos os computadores."
                FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
