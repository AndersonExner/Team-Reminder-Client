<UserControl x:Class="TeamReminder.Windows.GroupsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="32,8,32,32" MaxWidth="1000" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Grupos" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Crie sua equipe, convide colegas e publique alarmes para todos." Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Atualizar grupos e convites" AutomationProperties.Name="Atualizar grupos e convites">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="CreateButton" Grid.Column="2" Click="Create_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Criar grupo" /></StackPanel>
                </Button>
            </Grid>
            <InfoBar x:Name="LoginHint" IsOpen="True" IsClosable="False" Severity="Informational" Title="Entre na sua conta"
                Message="Acesse Configurações → Conta para usar grupos e convites." />
            <ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True" />
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />

            <StackPanel x:Name="ConnectedContent" Spacing="12" Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE715;" FontSize="16" />
                        <TextBlock Text="Convites recebidos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyInvitations" Text="Nenhum convite pendente." Style="{StaticResource SecondaryTextStyle}" />
                    <ListView x:Name="IncomingList" MaxHeight="200" SelectionChanged="Selection_Changed">
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Spacing="2" Padding="0,8">
                                <TextBlock Text="{Binding GroupName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AcceptButton" Content="Aceitar convite" Click="Accept_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="DeclineButton" Content="Recusar" Click="Decline_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" Padding="8,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Meus grupos" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="8,0" />
                        <TextBlock x:Name="EmptyGroups" Text="Você ainda não participa de grupos." Style="{StaticResource SecondaryTextStyle}" Margin="8,0" />
                        <ListView x:Name="GroupList" SelectionChanged="Group_Changed" MaxHeight="460">
                            <ListView.ItemTemplate><DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <FontIcon Glyph="&#xE902;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MembershipLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="SelectedName" Text="Selecione um grupo" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedDescription" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Name="SelectedRole" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="EditButton" Click="Edit_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="13" /><TextBlock Text="Editar" /></StackPanel>
                            </Button>
                            <Button x:Name="LeaveButton" Click="Leave_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE89B;" FontSize="13" /><TextBlock Text="Sair do grupo" /></StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" Click="Delete_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Excluir grupo" /></StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Participantes" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <ListView x:Name="MembersList" MaxHeight="280" SelectionChanged="Selection_Changed">
                            <ListView.ItemTemplate><DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <PersonPicture Width="32" Height="32" DisplayName="{Binding Name}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource ChipStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource ChipTextStyle}" />
                                    </Border>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="AdminPanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PromoteButton" Content="Tornar administrador" Click="Promote_Click" />
                                <Button x:Name="DemoteButton" Content="Tornar membro" Click="Demote_Click" />
                                <Button x:Name="RemoveButton" Content="Remover" Click="Remove_Click" />
                                <Button x:Name="TransferButton" Content="Transferir propriedade" Click="Transfer_Click" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="InviteEmail" Header="Convidar por e-mail (conta cadastrada)" PlaceholderText="colega@empresa.com" MaxLength="254" InputScope="EmailSmtpAddress" />
                                <Button x:Name="InviteButton" Grid.Column="1" Click="Invite_Click" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE724;" FontSize="13" /><TextBlock Text="Convidar" /></StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="Convites enviados pendentes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ListView x:Name="OutgoingList" MaxHeight="160" SelectionChanged="Selection_Changed">
                                <ListView.ItemTemplate><DataTemplate>
                                    <StackPanel Spacing="2" Padding="0,6">
                                        <TextBlock Text="{Binding Email}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CancelInviteButton" Content="Cancelar convite selecionado" Click="CancelInvite_Click" />
                                <Button x:Name="HistoryButton" Click="History_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE81C;" FontSize="13" /><TextBlock Text="Histórico" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
