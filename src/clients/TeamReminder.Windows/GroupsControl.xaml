<UserControl x:Class="TeamReminder.Windows.GroupsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,16,0,0">
            <TextBlock Text="Grupos" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Crie sua equipe, convide colegas e gerencie participantes." TextWrapping="Wrap" />
            <TextBlock x:Name="LoginHint" Text="Entre na sua conta em Configurações para acessar grupos e convites." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CreateButton" Content="Criar grupo" Click="Create_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="RefreshButton" Content="Atualizar grupos e convites" Click="Refresh_Click" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Border Padding="20" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Convites recebidos" FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyInvitations" Text="Nenhum convite pendente." />
                    <ListView x:Name="IncomingList" MaxHeight="200" SelectionChanged="Selection_Changed">
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Spacing="4" Padding="4,8">
                                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AcceptButton" Content="Aceitar convite" Click="Accept_Click" />
                        <Button x:Name="DeclineButton" Content="Recusar convite" Click="Decline_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="20" CornerRadius="12" VerticalAlignment="Top" Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Meus grupos" FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyGroups" Text="Você ainda não participa de grupos." TextWrapping="Wrap" />
                        <ListView x:Name="GroupList" SelectionChanged="Group_Changed" MaxHeight="420">
                            <ListView.ItemTemplate><DataTemplate>
                                <StackPanel Spacing="4" Padding="4,8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MembershipLabel}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" CornerRadius="12" VerticalAlignment="Top" Background="{ThemeResource ControlFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="SelectedName" Text="Selecione um grupo" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedDescription" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedRole" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="EditButton" Content="Editar grupo" Click="Edit_Click" />
                            <Button x:Name="LeaveButton" Content="Sair do grupo" Click="Leave_Click" />
                            <Button x:Name="DeleteButton" Content="Excluir grupo" Click="Delete_Click" />
                        </StackPanel>
                        <TextBlock Text="Participantes" FontWeight="SemiBold" />
                        <ListView x:Name="MembersList" MaxHeight="240" SelectionChanged="Selection_Changed">
                            <ListView.ItemTemplate><DataTemplate>
                                <StackPanel Spacing="3" Padding="4,8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Email}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RoleLabel}" />
                                </StackPanel>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="AdminPanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <Button x:Name="PromoteButton" Content="Tornar administrador" Click="Promote_Click" />
                                <Button x:Name="DemoteButton" Content="Tornar membro" Click="Demote_Click" />
                                <Button x:Name="RemoveButton" Content="Remover participante" Click="Remove_Click" />
                                <Button x:Name="TransferButton" Content="Transferir propriedade" Click="Transfer_Click" />
                            </StackPanel>
                            <TextBox x:Name="InviteEmail" Header="E-mail de uma conta cadastrada" MaxLength="254" InputScope="EmailSmtpAddress" />
                            <Button x:Name="InviteButton" Content="Enviar convite" Click="Invite_Click" />
                            <TextBlock Text="Convites enviados pendentes" FontWeight="SemiBold" />
                            <ListView x:Name="OutgoingList" MaxHeight="160" SelectionChanged="Selection_Changed">
                                <ListView.ItemTemplate><DataTemplate>
                                    <StackPanel Spacing="3" Padding="4,8">
                                        <TextBlock Text="{Binding Email}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="CancelInviteButton" Content="Cancelar convite selecionado" Click="CancelInvite_Click" />
                            <Button x:Name="HistoryButton" Content="Consultar histórico" Click="History_Click" />
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
